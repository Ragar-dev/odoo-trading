<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trading_etoro_statement_import_form" model="ir.ui.view">
        <field name="name">trading.etoro.statement.import.form</field>
        <field name="model">trading.etoro.statement.import</field>
        <field name="arch" type="xml">
            <form string="Importar extracto de eToro">
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p class="text-muted">
                        En eToro, descargue el estado de cuenta (<em>Account Statement</em>) del periodo que quiera en
                        formato Excel. Odoo leerá la hoja de posiciones cerradas y sustituirá los cierres estimados por
                        los reales (precio, resultado y comisiones). Las posiciones que no estaban en Odoo se crean si
                        se reconoce el instrumento.
                    </p>
                    <group>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <field name="result" nolabel="1" class="font-monospace"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_confirmed" type="object" string="Ver posiciones confirmadas"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trading_etoro_statement_import" model="ir.actions.act_window">
        <field name="name">Importar extracto de eToro</field>
        <field name="res_model">trading.etoro.statement.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_trading_etoro_statement_import" name="Importar extracto de eToro"
              parent="trading_base.menu_trading_operations" action="action_trading_etoro_statement_import"
              sequence="90" groups="trading_base.group_trading_manager"/>
</odoo>
