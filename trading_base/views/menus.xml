<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_trading_live_board" model="ir.actions.client">
        <field name="name">Panel en vivo</field>
        <field name="tag">trading_base.LiveBoard</field>
    </record>

    <menuitem id="menu_trading_root" name="Trading" sequence="45"
              web_icon="trading_base,static/description/icon.png"
              groups="trading_base.group_trading_user"/>
    <menuitem id="menu_trading_live" name="Panel en vivo" parent="menu_trading_root"
              action="action_trading_live_board" sequence="1"/>
    <record id="action_trading_web" model="ir.actions.act_url">
        <field name="name">Web de trading</field>
        <field name="url">/trading</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_trading_web" name="Web de trading" parent="menu_trading_root"
              action="action_trading_web" sequence="2"/>
    <menuitem id="menu_trading_operations" name="Operaciones" parent="menu_trading_root" sequence="10"/>
    <menuitem id="menu_trading_positions" name="Posiciones" parent="menu_trading_operations"
              action="action_trading_position" sequence="1"/>
    <menuitem id="menu_trading_mirrors" name="Carteras copiadas" parent="menu_trading_operations"
              action="action_trading_mirror" sequence="3"/>
    <menuitem id="menu_trading_orders" name="Órdenes" parent="menu_trading_operations"
              action="action_trading_order" sequence="2"/>
    <menuitem id="menu_trading_market" name="Mercado" parent="menu_trading_root" sequence="20"/>
    <menuitem id="menu_trading_instruments" name="Instrumentos" parent="menu_trading_market"
              action="action_trading_instrument" sequence="1"/>
    <menuitem id="menu_trading_prices" name="Velas" parent="menu_trading_market"
              action="action_trading_price" sequence="2"/>
    <menuitem id="menu_trading_import" name="Importar instrumentos" parent="menu_trading_market"
              action="action_trading_instrument_import_wizard" sequence="3"/>
    <menuitem id="menu_trading_reporting" name="Informes" parent="menu_trading_root" sequence="30"/>
    <menuitem id="menu_trading_tax" name="Resultados fiscales" parent="menu_trading_reporting"
              action="action_trading_position_tax" sequence="1"/>
    <menuitem id="menu_trading_tax_pdf" name="Informe para la renta (PDF)" parent="menu_trading_reporting"
              action="action_trading_tax_report_wizard" sequence="2"/>
    <menuitem id="menu_trading_income" name="Dividendos e intereses" parent="menu_trading_reporting"
              action="action_trading_income" sequence="3"/>
    <menuitem id="menu_trading_config" name="Configuración" parent="menu_trading_root" sequence="90"
              groups="trading_base.group_trading_manager"/>
    <menuitem id="menu_trading_accounts" name="Cuentas de broker" parent="menu_trading_config"
              action="action_trading_broker_account" sequence="1"/>
</odoo>
