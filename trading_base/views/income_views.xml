<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trading_income_list" model="ir.ui.view">
        <field name="name">trading.income.list</field>
        <field name="model">trading.income</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="kind" widget="badge"/>
                <field name="name"/>
                <field name="isin" optional="show"/>
                <field name="country_code" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="gross" sum="Total"/>
                <field name="withholding" sum="Total"/>
                <field name="withholding_rate" optional="show"/>
                <field name="net" sum="Total"/>
                <field name="gross_company" sum="Total" optional="show"/>
                <field name="withholding_company" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_trading_income_form" model="ir.ui.view">
        <field name="name">trading.income.form</field>
        <field name="model">trading.income</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Dividendo de Apple"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="date"/>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="instrument_id" options="{'no_create': True}"/>
                            <field name="isin"/>
                            <field name="country_code"/>
                            <field name="broker_ref"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="gross"/>
                            <field name="withholding"/>
                            <field name="withholding_rate"/>
                            <field name="net"/>
                            <field name="gross_company"/>
                            <field name="withholding_company"/>
                            <field name="fiscal_year"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trading_income_pivot" model="ir.ui.view">
        <field name="name">trading.income.pivot</field>
        <field name="model">trading.income</field>
        <field name="arch" type="xml">
            <pivot string="Dividendos e intereses">
                <field name="fiscal_year" type="row"/>
                <field name="kind" type="col"/>
                <field name="gross_company" type="measure"/>
                <field name="withholding_company" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_trading_income_search" model="ir.ui.view">
        <field name="name">trading.income.search</field>
        <field name="model">trading.income</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="isin"/>
                <field name="account_id"/>
                <filter name="dividends" string="Dividendos" domain="[('kind', '=', 'dividend')]"/>
                <filter name="interests" string="Intereses" domain="[('kind', '=', 'interest')]"/>
                <group>
                    <filter name="group_year" string="Ejercicio" context="{'group_by': 'fiscal_year'}"/>
                    <filter name="group_country" string="País" context="{'group_by': 'country_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trading_income" model="ir.actions.act_window">
        <field name="name">Dividendos e intereses</field>
        <field name="res_model">trading.income</field>
        <field name="view_mode">list,pivot,form</field>
    </record>
</odoo>
