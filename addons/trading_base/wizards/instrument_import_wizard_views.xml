<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trading_instrument_import_wizard_form" model="ir.ui.view">
        <field name="name">trading.instrument.import.wizard.form</field>
        <field name="model">trading.instrument.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar instrumentos">
                <group>
                    <field name="account_id" options="{'no_create': True}"/>
                    <field name="query" placeholder="AAPL, NVDA, BTC, SPX500"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_trading_instrument_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar instrumentos</field>
        <field name="res_model">trading.instrument.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
