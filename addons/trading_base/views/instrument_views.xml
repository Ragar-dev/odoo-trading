<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trading_instrument_list" model="ir.ui.view">
        <field name="name">trading.instrument.list</field>
        <field name="model">trading.instrument</field>
        <field name="arch" type="xml">
            <list decoration-success="tick_direction == 'up'" decoration-danger="tick_direction == 'down'">
                <header>
                    <button name="action_refresh_prices" type="object" string="Refrescar precios"/>
                    <button name="action_load_candles" type="object" string="Cargar velas diarias"/>
                </header>
                <field name="watchlist" widget="boolean_toggle"/>
                <field name="symbol"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="account_id"/>
                <field name="bid"/>
                <field name="ask"/>
                <field name="last_price"/>
                <field name="change_pct" decoration-success="change_pct &gt; 0" decoration-danger="change_pct &lt; 0"/>
                <field name="quote_type" optional="hide"/>
                <field name="price_date" optional="show"/>
                <field name="tick_direction" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_trading_instrument_form" model="ir.ui.view">
        <field name="name">trading.instrument.form</field>
        <field name="model">trading.instrument</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_prices" type="object" string="Refrescar precio" class="btn-primary"/>
                    <button name="action_load_candles" type="object" string="Cargar velas diarias"/>
                    <button name="action_new_order" type="object" string="Nueva orden"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prices" type="object" class="oe_stat_button" icon="fa-area-chart" string="Velas"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="symbol" placeholder="AAPL"/></h1>
                        <field name="name" placeholder="Apple Inc."/>
                    </div>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="broker_ref"/>
                            <field name="asset_type"/>
                            <field name="watchlist"/>
                            <field name="tradingview_symbol"/>
                        </group>
                        <group string="Cotización">
                            <field name="bid"/>
                            <field name="ask"/>
                            <field name="last_price"/>
                            <field name="prev_close"/>
                            <field name="change_pct"/>
                            <field name="quote_type"/>
                            <field name="price_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Gráfica" name="chart">
                            <widget name="trading_chart"/>
                        </page>
                        <page string="TradingView" name="tradingview" invisible="not tradingview_symbol">
                            <field name="tradingview_symbol" widget="tradingview_chart" nolabel="1" readonly="1" class="d-block w-100"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trading_instrument_search" model="ir.ui.view">
        <field name="name">trading.instrument.search</field>
        <field name="model">trading.instrument</field>
        <field name="arch" type="xml">
            <search>
                <field name="symbol"/>
                <field name="name"/>
                <field name="account_id"/>
                <filter name="watchlist" string="En seguimiento" domain="[('watchlist', '=', True)]"/>
                <separator/>
                <filter name="up" string="Suben hoy" domain="[('change_pct', '&gt;', 0)]"/>
                <filter name="down" string="Bajan hoy" domain="[('change_pct', '&lt;', 0)]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'asset_type'}"/>
                    <filter name="group_account" string="Cuenta" context="{'group_by': 'account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_trading_instrument" model="ir.actions.act_window">
        <field name="name">Instrumentos</field>
        <field name="res_model">trading.instrument</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_watchlist': 1}</field>
    </record>
</odoo>
